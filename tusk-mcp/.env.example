# Build only: GitHub token with read access to msflib/fastapi. Set it in the Railway service
# variables; the Dockerfile uses it to install MSFLib and keeps it out of the final image.
GITHUB_TOKEN=

HOST=127.0.0.1
PORT=8100
# Set to your ngrok / Cloudflare Tunnel URL when connecting ChatGPT (MCP and payment links use it)
PUBLIC_BASE_URL=http://127.0.0.1:8100
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and changes the demo owner MCP tokens.
SECRET_KEY=change-me
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database: SQLite for local dev. For Postgres set USE_SQLITE=false and POSTGRES_* (msflib CoreSettings).
USE_SQLITE=true
SQLITE_DATABASE_URI=sqlite:///./tusk.db

# Redis keeps logouts (revoked tokens) across restarts; without it an in-memory store is used.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Paystack via msflib.payments. Use the sk_test_... key from dashboard.paystack.com → Settings → API Keys.
# Without a secret key, deposits use the built-in test checkout (no Paystack account needed).
# Webhook URL to paste in Paystack: <PUBLIC_BASE_URL>/pay/webhook  (signed with the same secret key)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Uploads (service photos) via msflib.utils.uploads: file | cloudinary | s3 | gcs | azure
# file: saved under STORAGE_PATH and served by this backend at STORAGE_BASE_URL. Nothing else needed.
STORAGE_METHOD=file
STORAGE_PATH=uploads
STORAGE_BASE_URL=/uploads
# cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# s3 (or S3-compatible), gcs, azure: also set STORAGE_BUCKET (bucket / container name)
STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=
GCS_CREDENTIALS_PATH=
AZURE_STORAGE_CONNECTION_STRING=

# Owner notifications: in-app always; email when EMAILS_ENABLED and SMTP_* are set; SMS when TWILIO_* are set.
EMAILS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public website (tusk-dashboard); business profiles live at SITE_URL/<slug>
SITE_URL=http://localhost:3000
# Address -> coordinates for "closest" recommendations (OpenStreetMap; empty turns distance off)
GEOCODER_URL=https://nominatim.openstreetmap.org/search

HOLD_MINUTES=30
OWNER_MCP_TOKEN_DAYS=365
SEED_DEMO=true
